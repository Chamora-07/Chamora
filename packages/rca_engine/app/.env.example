# -------------------------------------------------------
# AI Performance RCA Engine — environment configuration
# Copy this to .env and fill in your values.
# -------------------------------------------------------

# Google Gemini API key (leave blank to use synthetic fallback only)
GEMINI_API_KEY=AIzaSyBGU_bpk5w9nZWF21pzo9AoCFbZMbS1YrA

# Which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash-lite

# Set to false to force synthetic rule-based analysis (no LLM calls)
USE_LLM=true

# Seconds between Gemini calls in batch mode (free tier = 10 RPM → 6s)
GEMINI_RPM_DELAY=6.0

# Enable SRE guardrails that override incorrect LLM classifications
GUARDRAILS_ENABLED=true

# -------------------------------------------------------
# Metric thresholds (tune to match your SLA baseline)
# -------------------------------------------------------
THRESHOLD_LATENCY_P95=0.05
THRESHOLD_ERROR_RATE=0.01
THRESHOLD_CPU_USAGE=0.85
THRESHOLD_MEMORY_BYTES=900000000
THRESHOLD_MEMORY_PRESSURE=0.80
THRESHOLD_MEMORY_GROWTH=50000000
THRESHOLD_DISK_IO=0.80
THRESHOLD_CPU_NODE_RATIO=0.90
THRESHOLD_FAILURE_STREAK=5

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["*"]
